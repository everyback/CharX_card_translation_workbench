WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=8787
# Docker Compose 宿主机绑定端口。仅绑定 127.0.0.1，可改为未占用端口。
WORKBENCH_BIND_PORT=8787
WORKBENCH_UPLOAD_LIMIT_MB=0
WORKBENCH_DB_WORKERS=3
# 运行数据和构建目录。留空时使用工作台目录下的默认路径。
# WORKBENCH_DATA_DIR=data
# WORKBENCH_DB_PATH=data/workbench.sqlite
# WORKBENCH_UNPACK_SESSIONS_DIR=data/unpack-sessions
# WORKBENCH_TAVERN_CARD_SESSIONS_DIR=data/tavern-card-sessions
# WORKBENCH_OCR_CACHE_DIR=data/ocr-cache
# WORKBENCH_WEB_DIR=dist
# WORKBENCH_NODE_MODULES_DIR=node_modules
# 模型、语言、调度和图片设置只能在页面左侧底部的“模型设置”中配置。
