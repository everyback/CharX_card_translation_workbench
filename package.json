{
  "name": "card-translation-workbench",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@eslint-community/regexpp": "^4.12.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "fastify": "^5.0.0",
    "fflate": "^0.8.3",
    "luaparse": "^0.3.1",
    "lucide-react": "^0.468.0",
    "png-chunk-text": "^1.0.0",
    "png-chunks-encode": "^1.0.0",
    "png-chunks-extract": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/luaparse": "^0.2.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "@fastify/ajv-compiler": {
      "fast-uri": "3.1.5"
    },
    "ajv": {
      "fast-uri": "3.1.5"
    },
    "fast-json-stringify": {
      "fast-uri": "4.1.2"
    },
    "nanoid": "3.3.18"
  }
}
